# LATROCORE Environment Configuration Example
# Copy to .env and configure for your environment

# Project & Environment Mode (development | production)
PROJECT_NAME=LATROCORE
ENVIRONMENT=development
PORT=8000

# Database Configuration (PostgreSQL in production; SQLite supported in tests)
# Example PostgreSQL: postgresql+psycopg2://postgres:your_password@localhost:5432/latrocore
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/latrocore

# Cryptographic Keys (MUST be at least 32 characters; server fails startup if insecure)
JWT_SECRET=super_secret_signing_key_at_least_32_characters_long_for_security_production
JWT_ALGORITHM=HS256
JWT_ISSUER=latrocore-auth
JWT_AUDIENCE=latrocore-client

# Token Lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Secure Cookie Settings
# RFC 6265bis: __Host- prefix requires Secure=True, Path=/, and NO Domain attribute
COOKIE_NAME=__Host-refresh
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
COOKIE_PATH=/

# Rate Limiting Controls (per 15-minute window)
MAX_LOGIN_ATTEMPTS_PER_ACCOUNT=5
MAX_LOGIN_ATTEMPTS_PER_IP=10
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_LOCKOUT_MINUTES=15

# SMTP Email Configuration (Optional in local development; required for real email delivery)
# When empty, OTPs are printed to the backend terminal and returned in dev mode.
# To send real emails via Gmail:
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords and create an App Password (16 letters)


# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=enoenoch945@gmail.com
# SMTP_PASS=ncgr dpgt rpww krpc
# EMAIL_FROM_NAME="NiftyBanner Support"
# EMAIL_FROM_ADDRESS=enoenoch945@gmail.com